---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Inscription" heroTitle="Inscription" heroDescription="Créez votre compte">
  <section class="w-full bg-[#02030d] px-4 py-12 text-white min-h-screen">
    <div class="mx-auto w-full max-w-md">
      
      <div class="flex gap-4 mb-8">
        <a 
          href="/authentification" 
          class="flex-1 rounded-lg border-2 border-blue-600 bg-black py-3 text-center text-lg font-semibold text-zinc-400 transition hover:text-blue-400 hover:border-blue-500"
        >
          Connexion
        </a>
        <a 
          href="/authentification/inscription" 
          class="flex-1 rounded-lg border-2 border-violet-600 bg-violet-950 py-3 text-center text-lg font-semibold text-violet-400 transition hover:bg-violet-900"
        >
          Inscription
        </a>
      </div>


      <div class="rounded-2xl border border-violet-500 bg-black px-6 py-8 shadow-[0_0_18px_rgba(168,85,247,0.08)]">
        <h2 class="text-violet-500 mb-6">Créer un compte</h2>
        
        <form id="register-form" class="space-y-6">
          <div id="register-error" class="hidden rounded-lg bg-red-900/30 border border-red-500 px-4 py-3 text-red-300 text-sm"></div>
          <div id="register-success" class="hidden rounded-lg bg-green-900/30 border border-green-500 px-4 py-3 text-green-300 text-sm"></div>
          
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div>
              <label for="register-prenom" class="block text-sm font-medium mb-2 text-zinc-300">Prénom *</label>
              <input
                type="text"
                id="register-prenom"
                name="prenom"
                required
                class="w-full rounded-lg border border-violet-500 bg-black px-4 py-3 text-white placeholder-zinc-500 focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-500/50"
                placeholder="Jean"
              />
            </div>

            <div>
              <label for="register-nom" class="block text-sm font-medium mb-2 text-zinc-300">Nom *</label>
              <input
                type="text"
                id="register-nom"
                name="nom"
                required
                class="w-full rounded-lg border border-violet-500 bg-black px-4 py-3 text-white placeholder-zinc-500 focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-500/50"
                placeholder="Dupont"
              />
            </div>
          </div>

          <div>
            <label for="register-email" class="block text-sm font-medium mb-2 text-zinc-300">Email *</label>
            <input
              type="email"
              id="register-email"
              name="email"
              required
              class="w-full rounded-lg border border-violet-500 bg-black px-4 py-3 text-white placeholder-zinc-500 focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-500/50"
              placeholder="votre@email.com"
            />
          </div>

          <div>
            <label for="register-password" class="block text-sm font-medium mb-2 text-zinc-300">Mot de passe *</label>
            <input
              type="password"
              id="register-password"
              name="password"
              required
              minlength="8"
              class="w-full rounded-lg border border-violet-500 bg-black px-4 py-3 text-white placeholder-zinc-500 focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-500/50"
              placeholder="••••••••"
            />
            <p class="mt-1 text-xs text-zinc-500">Minimum 8 caractères</p>
          </div>

          <div>
            <label for="register-password-confirm" class="block text-sm font-medium mb-2 text-zinc-300">Confirmer le mot de passe *</label>
            <input
              type="password"
              id="register-password-confirm"
              name="password-confirm"
              required
              minlength="8"
              class="w-full rounded-lg border border-violet-500 bg-black px-4 py-3 text-white placeholder-zinc-500 focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-500/50"
              placeholder="••••••••"
            />
          </div>

          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" required class="mt-1 rounded border-zinc-600 bg-zinc-800 text-violet-600 focus:ring-violet-500" />
            <span class="text-sm text-zinc-400">
              J'accepte les <a href="#" class="text-violet-400 hover:text-violet-300">conditions générales</a> et la <a href="#" class="text-violet-400 hover:text-violet-300">politique de confidentialité</a>
            </span>
          </label>

          <button
            type="submit"
            class="w-full rounded-lg bg-linear-to-r from-violet-600 to-fuchsia-600 px-6 py-3 font-semibold text-white transition hover:from-violet-500 hover:to-fuchsia-500 focus:outline-none focus:ring-2 focus:ring-violet-500"
          >
            S'inscrire
          </button>

          <p class="text-center text-sm text-zinc-400 mt-4">
            Déjà un compte ? <a href="/authentification" class="text-blue-400 hover:text-blue-300 font-semibold">Se connecter</a>
          </p>
        </form>
      </div>

    </div>
  </section>
</Layout>

<script>
  import { registerUser, checkEmailExists } from '../../../backend/backend.mjs';

  const registerForm = document.getElementById('register-form');
  const registerError = document.getElementById('register-error');
  const registerSuccess = document.getElementById('register-success');

  registerForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(registerForm);
    const prenom = formData.get('prenom');
    const nom = formData.get('nom');
    const email = formData.get('email');
    const password = formData.get('password');
    const passwordConfirm = formData.get('password-confirm');

    registerError?.classList.add('hidden');
    registerSuccess?.classList.add('hidden');

    if (password !== passwordConfirm) {
      if (registerError) {
        registerError.textContent = 'Les mots de passe ne correspondent pas';
        registerError.classList.remove('hidden');
      }
      return;
    }

    if (password.length < 8) {
      if (registerError) {
        registerError.textContent = 'Le mot de passe doit contenir au moins 8 caractères';
        registerError.classList.remove('hidden');
      }
      return;
    }

    try {
      const emailExists = await checkEmailExists(email);
      if (emailExists) {
        if (registerError) {
          registerError.textContent = 'Cet email est déjà utilisé';
          registerError.classList.remove('hidden');
        }
        return;
      }

      const result = await registerUser({
        prenom,
        nom,
        email,
        password,
        passwordConfirm
      });
      
      if (result.success) {
        if (registerSuccess) {
          registerSuccess.textContent = 'Inscription réussie ! Redirection vers la connexion...';
          registerSuccess.classList.remove('hidden');
        }
        
        registerForm.reset();
        
        setTimeout(() => {
          window.location.href = '/authentification';
        }, 2000);
      } else {
        if (registerError) {
          registerError.textContent = result.error || 'Erreur lors de l\'inscription';
          registerError.classList.remove('hidden');
        }
      }
    } catch (error) {
      if (registerError) {
        registerError.textContent = 'Une erreur est survenue lors de l\'inscription';
        registerError.classList.remove('hidden');
      }
    }
  });
</script>
