---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';

const logos = [
  "/logo-doubs.svg",
  "/Montbeliard-logo.svg",
  "/logo_tourisme.svg",
  "/Logo-BFC.svg"
];
---

<Layout title="FlyTapFest">
  <section class="bg-black text-white py-20">
    <div class="container-grid">
      <div class="col-span-12">
        <h2 class="text-blue-600">Festival de claquettes</h2>
        <p class="mt-2">Fusion entre claquettes traditionnelles et spectacle de drones lumineux</p>
      </div>

      <div class="col-span-12 flex flex-col items-end gap-3 lg:flex-row lg:justify-end lg:gap-6 mt-5">
        <div class="flex items-start gap-2">
          <img class="h-6" src="/Icon-calendar.svg" alt="Calendrier"/>
          <p class="font-bold">6-7 juin 2026</p>
        </div>
        <div class="flex items-start gap-2">
          <img class="h-6" src="/Icon-ping.svg" alt="localisation"/>
          <p>Parc du Près-la-Rose, Montbéliard</p>
        </div>
      </div>

      <div class="col-span-12 mt-5">
        <Button bouton="Réservez mes billets" href="/billeterie" />
      </div>
    </div>
  </section>

  <section class="bg-black text-white py-10">
    <div class="container-grid">
      <div class="col-span-12">
        <h3>Un festival entre ciel et terre</h3>
        <p class="mt-5">Le FlyTapFest est un événement unique qui marie l'art ancestral des claquettes avec la technologie moderne des drones lumineux pour créer un spectacle époustouflant.</p>
      </div>
      <div class="col-span-12 mt-5">
        <Button bouton="En savoir plus" href="/infos"/>
      </div>
    </div>
  </section>

  <section class="bg-black py-10">
    <div class="container-grid">
      <div class="col-span-12">
        <h3 class="mb-5 text-white">Découvrir le festival</h3>
      </div>
      
      <div class="col-span-12 lg:col-span-4 flex justify-center">
        <Card
          imageSrc="/drone.webp"
          titre="Programme"
          description="Découvrez tous les spectacles et performances de claquettes qui rythmeront le FlyTapFest. Des artistes exceptionnels vous attendent sur nos différentes scènes."
          href="/programmation"
        />
      </div>
      
      <div class="col-span-12 lg:col-span-4 flex justify-center">
        <Card
          imageSrc="/scene_princi.webp"
          titre="Scènes"
          description="Découvrez toutes les scènes sont situées dans le Parc du Près-la-Rose à Montbéliard."
          href="/scene"
        />
      </div>
      
      <div class="col-span-12 lg:col-span-4 flex justify-center">
        <Card
          imageSrc="/artistes.webp"
          titre="Artistes"
          description="Découvrez tous les artistes qui participeront au FlyTapFest."
          href="/artiste"
        />
      </div>
    </div>
  </section>

  <section class="bg-black py-10">
    <div class="container-grid">
      <div class="col-span-12">
        <img class="w-full object-contain rounded-xl" src="/scene_princi.webp" alt="scene principal"/>
        <h3 class="mt-5 mb-10">Nos partenaires</h3>
      </div>
    </div>

  <div class="w-full overflow-hidden bg-white py-6">
  <div id="logo-track" class="flex w-max items-center gap-16 px-6 ">
    
    {logos.concat(logos).map((logo) => (
      <img
        src={logo}
        alt="Partenaire"
        class="h-16 w-auto object-contain"
      />
    ))}

  </div>
</div>

<script>
  const track = document.getElementById("logo-track");

  let position = 0;
  const speed = 0.5;

  function animate() {
    position -= speed;

    if (Math.abs(position) >= track.scrollWidth / 2) {
      position = 0;
    }

    track.style.transform = `translateX(${position}px)`;

    requestAnimationFrame(animate);
  }

  animate();
</script>
</Layout>
