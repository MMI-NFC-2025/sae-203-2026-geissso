---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import { getSceneById, getArtistesBySceneId } from "../../../backend/backend.mjs";

const { id } = Astro.params;
let scene = null;
let artistes = [];
let error = null;

try {
  scene = await getSceneById(id);
  
  if (!scene) {
    return Astro.redirect('/404');
  }
  
  artistes = await getArtistesBySceneId(id);
} catch (e) {
  console.error('Erreur lors de la récupération de la scène:', e);
  error = e.message;
}
---

<Layout title={scene?.nom || "Scène"} heroTitle={scene?.nom || "Scène"} heroDescription={scene?.description || "Scène du FlyTapFest 2026"} heroRecord={scene} heroRecordImage={scene?.img}>
  {error && (
    <section class="bg-black text-white py-10">
      <div class="container-grid">
        <div class="col-span-12 text-center text-red-400 p-8">
          <p class="text-xl">Impossible de charger la scène pour le moment.</p>
          <p class="text-sm mt-2">Erreur: {error}</p>
          <div class="mt-4">
            <Button href="/scene" bouton="Retour aux scènes" />
          </div>
        </div>
      </div>
    </section>
  )}
  {!error && scene && (
  <Fragment>
    <section class="bg-black text-white py-10">
      <div class="container-grid">
        <div class="col-span-12 mb-8">
          <Button href="/scene" bouton="Retour aux scènes" />
        </div>
        
        <div class="col-span-12 flex flex-wrap gap-6">
          {scene.capacite && (
            <div class="flex items-center gap-3">
              <svg class="h-6 w-6 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
              </svg>
              <p class="text-lg">Capacité : {scene.capacite} personnes</p>
            </div>
          )}
        </div>
      </div>
    </section>

    {scene.description && (
      <section class="bg-black text-white py-10">
        <div class="container-grid">
          <div class="col-span-12">
            <h2 class="mb-6">Description</h2>
            <p class="text-gray-300 leading-relaxed text-lg">{scene.description}</p>
          </div>
          
          {scene.localisation && (
            <div class="col-span-12 mt-6">
              <div class="inline-flex items-center gap-3 bg-gray-900 px-6 py-3 rounded-xl border border-blue-500/30">
                <img src="/Icon-ping.svg" alt="Localisation" class="h-6 w-6" />
                <span class="text-lg font-semibold">{scene.localisation}</span>
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    {artistes && artistes.length > 0 && (
      <section class="bg-black text-white py-10">
        <div class="container-grid">
          <div class="col-span-12">
            <h2 class="mb-8">Programme de cette scène</h2>
          </div>
          
          <div class="col-span-12 space-y-4">
            {artistes.map((artiste) => (
              <a 
                href={`/artiste/${artiste.id}`}
                class="block bg-gray-900 p-6 rounded-xl border border-blue-500/30 hover:border-blue-400 transition-all hover:shadow-[0_0_20px_rgba(236,72,153,0.3)]"
              >
                <h3 class="text-2xl font-bold mb-2">{artiste.nom}</h3>
                {artiste.horaires && (
                  <div class="flex items-center gap-2 text-gray-400">
                    <img src="/Icon-calendar.svg" alt="Date" class="h-5 w-5" />
                    <p>{new Date(artiste.horaires).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' })} · {new Date(artiste.horaires).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</p>
                  </div>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </Fragment>
  )}
</Layout>