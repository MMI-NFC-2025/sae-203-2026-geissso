---
import Layout from "../../layouts/Layout.astro";
import PbImage from "../../components/PbImage.astro";
import CardBack from "../../components/CardBack.astro";
import { getSceneById, getArtistesBySceneId } from "../../../backend/backend.mjs";

const { id } = Astro.params;
let scene = null;
let artistes = [];
let error = null;

try {
  scene = await getSceneById(id);
  
  if (!scene) {
    return Astro.redirect('/404');
  }
  
  artistes = await getArtistesBySceneId(id);
} catch (e) {
  console.error('Erreur lors de la récupération de la scène:', e);
  error = e.message;
}
---

<Layout title={scene?.nom || "Scène"} heroTitle={scene?.nom || "Scène"} heroDescription={scene?.description || "Scène du FlyTapFest 2026"}>
  {error && (
    <section class="bg-black text-white py-10">
      <div class="container-grid">
        <div class="col-span-12 text-center text-red-400 p-8">
          <p class="text-xl">Impossible de charger la scène pour le moment.</p>
          <p class="text-sm mt-2">Erreur: {error}</p>
          <a href="/scene" class="mt-4 inline-block px-5 py-3 bg-blue-500/20 border-2 border-blue-500 rounded-xl font-bold">Retour aux scènes</a>
        </div>
      </div>
    </section>
  )}
  {!error && scene && (
  <section class="bg-black text-white py-10">
    <div class="container-grid">
      <div class="col-span-12 mb-8">
        <a href="/scene" class="inline-block px-5 py-3 bg-blue-500/20 border-2 border-blue-500 rounded-xl font-bold text-exo text-white shadow-[0_0_20px_rgba(236,72,153,0.3)] hover:shadow-[0_0_30px_rgba(236,72,153,0.5)] transition-shadow">
          Retour aux scènes
        </a>
      </div>
      
      <div class="col-span-12">
      {scene.img && (
        <div class="mb-8 rounded-xl overflow-hidden border-2 border-blue-500 shadow-[0_0_30px_rgba(236,72,153,0.4)]">
          <PbImage 
            record={scene} 
            recordImage={scene.img} 
            width={1200} 
            height={600}
            alt={scene.nom}
            class="w-full h-96 object-cover"
          />
        </div>
      )}
      
      <div class="space-y-8">
        {scene.description && (
          <div>
            <h2 class="text-3xl font-bold mb-4 text-blue-400">Description</h2>
            <p class="text-gray-300 leading-relaxed text-lg">{scene.description}</p>
          </div>
        )}
        
        <div class="grid md:grid-cols-2 gap-6">
          {scene.capacite && (
            <div class="flex items-center gap-4 bg-gray-900 p-6 rounded-xl border border-blue-500/30">
              <svg class="h-8 w-8 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
              </svg>
              <div>
                <p class="text-sm text-gray-400">Capacité</p>
                <p class="text-xl font-semibold">{scene.capacite} personnes</p>
              </div>
            </div>
          )}
          
          {scene.localisation && (
            <div class="flex items-center gap-4 bg-gray-900 p-6 rounded-xl border border-blue-500/30">
              <img src="/Icon-ping.svg" alt="Localisation" class="h-8 w-8" />
              <div>
                <p class="text-sm text-gray-400">Localisation</p>
                <p class="text-xl font-semibold">{scene.localisation}</p>
              </div>
            </div>
          )}
        </div>
        
        {artistes && artistes.length > 0 && (
          <div class="mt-12">
            <h2 class="text-3xl font-bold mb-6 text-blue-400">Artistes sur cette scène</h2>
          </div>
        )}
      </div>
      </div>
      
      <div class="col-span-12 flex flex-wrap gap-8 justify-center">
        {artistes && artistes.length > 0 && artistes.map((artiste) => (
          <CardBack
            nom={artiste.nom}
            horaires={artiste.horaires}
            scene={scene.nom}
            record={artiste}
            recordImage={artiste.img}
            href={`/artiste/${artiste.id}`}
          />
        ))}
      </div>
    </div>
  </section>
  )}
</Layout>