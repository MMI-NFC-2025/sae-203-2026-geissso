---
import Layout from "../../layouts/Layout.astro";
import PBImage from "../../components/PbImage.astro";
import { getArtisteById } from "../../../backend/backend.mjs";

const { id } = Astro.params;
const artiste = await getArtisteById(id);

if (!artiste) {
  return Astro.redirect('/404');
}

const sceneName = artiste.expand?.scene?.nom || 'Scène non définie';
const sceneId = artiste.expand?.scene?.id;
---

<Layout title={artiste.nom} heroTitle={artiste.nom} heroDescription={artiste.description || "Artiste du FlyTapFest 2026"}>
  <section class="bg-black text-white py-10">
    <div class="container-grid">
      <div class="col-span-12 mb-8">
        <a href="/artiste" class="inline-block px-5 py-3 bg-blue-500/20 border-2 border-blue-500 rounded-xl font-bold text-exo text-white shadow-[0_0_20px_rgba(236,72,153,0.3)] hover:shadow-[0_0_30px_rgba(236,72,153,0.5)] transition-shadow">
          ← Retour aux artistes
        </a>
      </div>
      
      <div class="col-span-12">
      {artiste.img && (
        <div class="mb-8 rounded-xl overflow-hidden border-2 border-blue-500 shadow-[0_0_30px_rgba(236,72,153,0.4)]">
          <PBImage 
            record={artiste} 
            recordImage={artiste.img} 
            width={800} 
            height={600}
            alt={artiste.nom}
            class="w-full h-96 object-cover"
          />
        </div>
      )}
      
      <div class="space-y-8">
        {artiste.description && (
          <div>
            <h2 class="text-3xl font-bold mb-4 text-blue-400">Description</h2>
            <p class="text-gray-300 leading-relaxed text-lg">{artiste.description}</p>
          </div>
        )}
        
        <div class="grid md:grid-cols-3 gap-6">
          {artiste.horaires && (
            <div class="flex items-center gap-3 bg-gray-900 p-4 rounded-xl border border-blue-500/30">
              <img src="/Icon-calendar.svg" alt="Horaires" class="h-6 w-6" />
              <div>
                <p class="text-sm text-gray-400">Horaires</p>
                <p class="text-lg font-semibold">{artiste.horaires}</p>
              </div>
            </div>
          )}
          
          {artiste.genre && (
            <div class="flex items-center gap-3 bg-gray-900 p-4 rounded-xl border border-blue-500/30">
              <svg class="h-6 w-6 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M18 3a1 1 0 00-1.196-.98l-10 2A1 1 0 006 5v9.114A4.369 4.369 0 005 14c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V7.82l8-1.6v5.894A4.37 4.37 0 0015 12c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V3z"/>
              </svg>
              <div>
                <p class="text-sm text-gray-400">Genre</p>
                <p class="text-lg font-semibold">{artiste.genre}</p>
              </div>
            </div>
          )}
          
          {sceneName && (
            <a href={sceneId ? `/scene/${sceneId}` : '#'} class="flex items-center gap-3 bg-gray-900 p-4 rounded-xl border border-blue-500/30 hover:border-blue-400 transition-colors">
              <img src="/Icon-ping.svg" alt="Scène" class="h-6 w-6" />
              <div>
                <p class="text-sm text-gray-400">Scène</p>
                <p class="text-lg font-semibold">{sceneName}</p>
              </div>
            </a>
          )}
        </div>
        
        {artiste.galerie && artiste.galerie.length > 0 && (
          <div class="mt-10">
            <h2 class="text-3xl font-bold mb-6 text-blue-400">Galerie</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {artiste.galerie.map((image: string) => (
                <div class="rounded-xl overflow-hidden border-2 border-blue-500/50 hover:border-blue-400 transition-colors shadow-[0_0_15px_rgba(236,72,153,0.2)] hover:shadow-[0_0_25px_rgba(236,72,153,0.4)]">
                  <PBImage 
                    record={artiste} 
                    recordImage={image} 
                    width={400} 
                    height={300}
                    alt={`${artiste.nom} - Galerie`}
                    class="w-full h-64 object-cover"
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
      </div>
    </div>
  </section>
</Layout>