---
import Layout from "../../layouts/Layout.astro";
import PbImage from "../../components/PbImage.astro";
import Button from "../../components/Button.astro";
import { getArtisteById } from "../../../backend/backend.mjs";

const { id } = Astro.params;
let artiste = null;
let error = null;

try {
  artiste = await getArtisteById(id);
  
  if (!artiste) {
    return Astro.redirect('/404');
  }
} catch (e) {
  console.error('Erreur lors de la récupération de l’artiste:', e);
  error = e.message;
}

const sceneName = artiste?.expand?.scene?.nom || 'Scène non définie';
const sceneId = artiste?.expand?.scene?.id;
---

<Layout title={artiste?.nom || "Artiste"} heroTitle={artiste?.nom || "Artiste"} heroRecord={artiste} heroRecordImage={artiste?.img}>
  {error && (
    <section class="bg-black text-white py-10">
      <div class="container-grid">
        <div class="col-span-12 text-center text-red-400 p-8">
          <p class="text-xl">Impossible de charger l'artiste pour le moment.</p>
          <p class="text-sm mt-2">Erreur: {error}</p>
          <div class="mt-4">
            <Button href="/artiste" bouton="← Retour aux artistes" />
          </div>
        </div>
      </div>
    </section>
  )}
  {!error && artiste && (
  <Fragment>
    <section class="bg-black text-white py-10">
      <div class="container-grid">
        <div class="col-span-12 mb-8">
          <Button href="/artiste" bouton="Retour aux artistes" />
        </div>
        
        <div class="col-span-12 flex flex-wrap gap-6">
          {artiste.horaires && (
            <div class="flex items-center gap-3">
              <img src="/Icon-calendar.svg" alt="Horaires" class="h-6 w-6" />
              <p class="text-lg">{new Date(artiste.horaires).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })} à {new Date(artiste.horaires).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</p>
            </div>
          )}
          
          {sceneName && (
            <a href={sceneId ? `/scene/${sceneId}` : '#'} class="flex items-center gap-3 hover:text-blue-400 transition-colors">
              <img src="/Icon-ping.svg" alt="Scène" class="h-6 w-6" />
              <p class="text-lg">{sceneName}</p>
            </a>
          )}
        </div>
      </div>
    </section>

    {artiste.description && (
      <section class="bg-black text-white py-10">
        <div class="container-grid">
          <div class="col-span-12">
            <h2 class="mb-6">À propos</h2>
            <p class="text-gray-300 leading-relaxed text-lg">{artiste.description}</p>
          </div>
          
          {artiste.genre && (
            <div class="col-span-12 mt-6">
              <div class="inline-flex items-center gap-3 bg-gray-900 px-6 py-3 rounded-xl border border-blue-500/30">
                <svg class="h-6 w-6 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M18 3a1 1 0 00-1.196-.98l-10 2A1 1 0 006 5v9.114A4.369 4.369 0 005 14c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V7.82l8-1.6v5.894A4.37 4.37 0 0015 12c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V3z"/>
                </svg>
                <span class="text-lg font-semibold">{artiste.genre}</span>
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    {artiste.galerie && artiste.galerie.length > 0 && (
      <section class="bg-black text-white py-10">
        <div class="container-grid">
          <div class="col-span-12">
            <h2 class="mb-6">Galerie</h2>
          </div>
          
          <div class="col-span-12 hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {artiste.galerie.map((image: string) => (
              <div class="rounded-xl overflow-hidden border-2 border-blue-500/50 hover:border-blue-400 transition-colors shadow-[0_0_15px_rgba(236,72,153,0.2)] hover:shadow-[0_0_25px_rgba(236,72,153,0.4)]">
                <PbImage 
                  record={artiste} 
                  recordImage={image} 
                  width={400} 
                  height={300}
                  alt={`${artiste.nom} - Galerie`}
                  class="w-full h-64 object-cover"
                />
              </div>
            ))}
          </div>
          

          <div class="col-span-12 md:hidden">
            <div class="relative">
              <div id="carousel" class="overflow-hidden rounded-xl border-2 border-blue-500/50">
                <div id="carousel-inner" class="flex transition-transform duration-300 ease-in-out">
                  {artiste.galerie.map((image: string, index: number) => (
                    <div class="w-full shrink-0">
                      <PbImage 
                        record={artiste} 
                        recordImage={image} 
                        width={400} 
                        height={300}
                        alt={`${artiste.nom} - Galerie ${index + 1}`}
                        class="w-full h-80 object-cover"
                      />
                    </div>
                  ))}
                </div>
              </div>
              
              <div class="flex justify-center gap-4 mt-6">
                <button id="prev-btn" class="px-6 py-3 bg-blue-500/20 border-2 border-blue-500 rounded-xl font-bold text-white shadow-[0_0_20px_rgba(236,72,153,0.3)] hover:shadow-[0_0_30px_rgba(236,72,153,0.5)] transition-shadow">
                  ←
                </button>
                <button id="next-btn" class="px-6 py-3 bg-blue-500/20 border-2 border-blue-500 rounded-xl font-bold text-white shadow-[0_0_20px_rgba(236,72,153,0.3)] hover:shadow-[0_0_30px_rgba(236,72,153,0.5)] transition-shadow">
                  →
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}
  </Fragment>
  )}
</Layout>

<script>
  const carousel = document.getElementById('carousel-inner');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  
  if (carousel && prevBtn && nextBtn) {
    let currentIndex = 0;
    const totalImages = carousel.children.length;
    
    function updateCarousel() {
      const offset = -currentIndex * 100;
      carousel.style.transform = `translateX(${offset}%)`;
    }
    
    prevBtn.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + totalImages) % totalImages;
      updateCarousel();
    });
    
    nextBtn.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % totalImages;
      updateCarousel();
    });
  }
</script>