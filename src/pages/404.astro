---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Error 404" heroTitle='404'>
    <section class="bg-black text-white py-10">
        <div class="max-w-2xl mx-auto px-5 text-center">
            <p class="mb-8 text-lg">La page que vous recherchez n'existe pas.</p>
            <div class="flex justify-center">
                <Button bouton="Retour à l'accueil" href="/" />
            </div>
        </div>
    </section>
</Layout>