---
import Button from '../components/Button.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" heroTitle="Contact" heroDescription="Une question ? Contactez-nous">
    <section class="bg-black text-white">
        <div class="container-grid">
            <div class="col-span-12 lg:col-span-6">
                <h2 class="text-2xl font-bold mb-6 text-blue-400">Nos coordonées</h2>
                <div class="space-y-4 mt-8">
                    <div class="flex items-center gap-3">
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="h-6 w-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        <div>
                            <p class="text-sm text-gray-400">Email</p>
                            <a href="mailto:contact@flytapfest.fr" class="font-semibold hover:text-blue-400 transition">contact@flytapfest.fr</a>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="h-6 w-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        <div>
                            <p class="text-sm text-gray-400">Téléphone</p>
                            <a href="tel:+33123456789" class="font-semibold hover:text-blue-400 transition">+33 1 23 45 67 89</a>
                        </div>
                        </div>
                        <div class="flex items-center gap-3">
                        <img src="/Icon-ping.svg" alt="Adresse" class="h-6 w-6" />
                        <div>
                            <p class="text-sm text-gray-400">Adresse</p>
                            <p class="font-semibold">Parc du Près-la-Rose, Montbéliard</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-span-12 lg:col-span-6 mt-10 lg:mt-0">
                <form class="space-y-6">
                    <div>
                        <label for="nom" class="block text-sm font-medium mb-2 text-gray-300">Nom complet *</label>
                        <input
                            type="text"
                            id="nom"
                            name="nom"
                            required
                            class="w-full px-4 py-3 bg-black border-2 border-blue-500 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-blue-400 shadow-[0_0_15px_rgba(236,72,153,0.2)] focus:shadow-[0_0_25px_rgba(236,72,153,0.4)] transition-shadow"
                            placeholder="Votre nom"
                        />
                    </div>
                    
                    <div>
                        <label for="email" class="block text-sm font-medium mb-2 text-gray-300">Email *</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            class="w-full px-4 py-3 bg-black border-2 border-blue-500 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-blue-400 shadow-[0_0_15px_rgba(236,72,153,0.2)] focus:shadow-[0_0_25px_rgba(236,72,153,0.4)] transition-shadow"
                            placeholder="votre@email.com"
                        />
                    </div>
                    
                    <div>
                        <label for="sujet" class="block text-sm font-medium mb-2 text-gray-300">Sujet *</label>
                        <input
                            type="text"
                            id="sujet"
                            name="sujet"
                            required
                            class="w-full px-4 py-3 bg-black border-2 border-blue-500 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-blue-400 shadow-[0_0_15px_rgba(236,72,153,0.2)] focus:shadow-[0_0_25px_rgba(236,72,153,0.4)] transition-shadow"
                            placeholder="Objet de votre message"
                        />
                    </div>
                    
                    <div>
                        <label for="message" class="block text-sm font-medium mb-2 text-gray-300">Message *</label>
                        <textarea
                            id="message"
                            name="message"
                            required
                            rows="6"
                            class="w-full px-4 py-3 bg-black border-2 border-blue-500 rounded-xl text-white placeholder-gray-500 focus:outline-none focus:border-blue-400 shadow-[0_0_15px_rgba(236,72,153,0.2)] focus:shadow-[0_0_25px_rgba(236,72,153,0.4)] transition-shadow resize-none"
                            placeholder="Votre message..."
                        ></textarea>
                    </div>
                    
                    <Button
                        bouton='Envoyer le message'
                    </Button>
                </form>
            </div>
        </div>
    </section>
</Layout>