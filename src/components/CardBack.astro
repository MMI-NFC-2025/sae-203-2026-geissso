---
import PbImage from './PbImage.astro';

interface Props {
  nom?: string;
  horaires?: string;
  scene?: string;
  capacite?: number;
  description?: string;
  href?: string;
  className?: string;
  record?: any;
  recordImage?: string;
}

const { nom, horaires, scene, capacite, description, href, className = "", record, recordImage } = Astro.props;
const baseClasses = "block bg-black text-white rounded-xl border-2 border-blue-500 shadow-[0_0_20px_rgba(236,72,153,0.3)] hover:shadow-[0_0_30px_rgba(236,72,153,0.5)] transition-shadow p-3 w-[350px] h-[400px] flex flex-col";
const classes = `${baseClasses} ${className}`;

const Tag = href ? 'a' : 'article';
---

<Tag href={href} class={classes}>
  {record && recordImage && (
    <div class="mb-4 overflow-hidden rounded-t-lg">
      <PbImage 
        record={record} 
        recordImage={recordImage} 
        width={400} 
        height={300}
        alt={nom || 'Image'}
        class="w-full h-48 object-cover"
      />
    </div>
  )}
  {nom && <h3 class="text-xl font-semibold mb-3">{nom}</h3>}
  
  {horaires && (
    <div class="flex items-center gap-2 mb-2">
      <img src="/Icon-calendar.svg" alt="Horaires" class="h-5 w-5" />
      <p class="text-gray-300">{horaires}</p>
    </div>
  )}
  
  {scene && (
    <div class="flex items-center gap-2 mb-2">
      <img src="/Icon-ping.svg" alt="Scène" class="h-5 w-5" />
      <p class="text-gray-300">{scene}</p>
    </div>
  )}
  
  {capacite && (
    <div class="flex items-center gap-2 mb-2">
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
      </svg>
      <p class="text-gray-300">Capacité: {capacite} personnes</p>
    </div>
  )}
  
  {description && (
    <p class="text-gray-400 text-sm line-clamp-3 mt-2">{description}</p>
  )}
  
  <div class="grow"></div>
  
  <slot />
</Tag>
