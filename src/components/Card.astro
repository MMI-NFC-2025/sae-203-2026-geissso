---
interface Props {
  titre?: string;
  description?: string;
  href?: string;
  className?: string;
  imageSrc?: string;
}

const { titre, description, href, className = "", imageSrc } = Astro.props;
const baseClasses = "block bg-black text-white rounded-xl border-2 border-blue-500 shadow-[0_0_20px_rgba(236,72,153,0.3)] hover:shadow-[0_0_30px_rgba(236,72,153,0.5)] transition-shadow p-3 w-full max-w-sm";
const classes = `${baseClasses} ${className}`;

const Tag = href ? 'a' : 'article';
---

<Tag href={href} class={classes}>
  {imageSrc && (
    <div class="mb-4 rounded-lg overflow-hidden">
      <img src={imageSrc} alt={titre || 'Image'} class="w-full h-48 object-cover" />
    </div>
  )}
  {titre && <h3 class="text-xl font-semibold mb-2">{titre}</h3>}
  {description && <p class="text-gray-300">{description}</p>}
  <slot />
</Tag>