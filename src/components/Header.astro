---
import Menu from './Menu.astro';
---

<nav class="bg-black shadow fixed w-full z-50">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex justify-between items-center h-16">
      
      <a href="/">
        <img
          class="h-8 w-auto"
          src="/icon-logo-dark.svg"
          alt="Logo FlyTapFest"
        />
      </a>

      
      <div class="hidden lg:flex space-x-8 items-center">
        <a href="/festival" class="text-white hover:text-blue-400">Le Festival</a>
        <a href="/programmation" class="text-white hover:text-blue-400">Programme</a>
        <a href="/artiste" class="text-white hover:text-blue-400">Artistes</a>
        <a href="/scene" class="text-white hover:text-blue-400">Scènes</a>
        <a href="/infos" class="text-white hover:text-blue-400">Infos pratiques</a>
        <a href="/contact" class="text-white hover:text-blue-400">Contact</a>

        <div class="flex items-center space-x-4 border-l border-gray-600 pl-6">
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-blue-400"
            aria-label="Facebook"
          >
            <span class="text-sm">FB</span>
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-blue-400"
            aria-label="Instagram"
          >
            <span class="text-sm">IG</span>
          </a>
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden">
        <button id="menu-toggle-btn" class="text-white focus:outline-none relative w-6 h-6" aria-label="Menu">
          <span id="line1" class="absolute left-0 top-0 h-0.5 w-6 bg-white transition-all duration-300"></span>
          <span id="line2" class="absolute left-0 top-2.5 h-0.5 w-6 bg-white transition-all duration-300"></span>
          <span id="line3" class="absolute left-0 top-5 h-0.5 w-6 bg-white transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </div>
</nav>

<Menu />

<script>
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const line1 = document.getElementById('line1');
  const line2 = document.getElementById('line2');
  const line3 = document.getElementById('line3');
  
  let isMenuOpen = false;

  const closeMenu = () => {
    isMenuOpen = false;
    menu?.classList.add('hidden');
    menu?.classList.remove('flex');
    line1?.classList.remove('rotate-45', 'top-2.5');
    line2?.classList.remove('opacity-0');
    line3?.classList.remove('-rotate-45', 'top-2.5');
  };

  toggleBtn?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    
    if (isMenuOpen) {
      // Ouvrir le menu
      menu?.classList.remove('hidden');
      menu?.classList.add('flex');
      
      // Animer vers X
      line1?.classList.add('rotate-45', 'top-2.5');
      line2?.classList.add('opacity-0');
      line3?.classList.add('-rotate-45', 'top-2.5');
    } else {
      closeMenu();
    }
  });
  
  // Fermer avec le bouton X dans le menu
  closeBtn?.addEventListener('click', closeMenu);
  
  // Fermer le menu en cliquant sur un lien
  const menuLinks = menu?.querySelectorAll('a');
  menuLinks?.forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
