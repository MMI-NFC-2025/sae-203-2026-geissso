---
const links = [
  { label: "Le Festival", href: "/festival" },
  { label: "Programme", href: "/programmation" },
  { label: "Artistes", href: "/artiste" },
  { label: "Scènes", href: "/scene" },
  { label: "Infos pratiques", href: "/infos" },
  { label: "Contact", href: "/contact" },
];
---

<div
  id="mobile-menu"
  class="fixed no-scroll inset-0 z-50 hidden min-h-screen w-full flex-col bg-[#02005c] text-white"
>
  <div class="flex items-center justify-between px-6 h-16">
    <a href="/" class="inline-flex">
      <img src="/icon-logo-dark.svg" alt="FlyTapFest" class="h-8 w-auto object-contain" />
    </a>
    
    <button
      id="close-menu-btn"
      type="button"
      aria-label="Fermer le menu"
      class="text-white focus:outline-none relative w-6 h-6"
    >
      <span class="absolute left-0 top-2.5 h-0.5 w-6 bg-white rotate-45"></span>
      <span class="absolute left-0 top-2.5 h-0.5 w-6 bg-white -rotate-45"></span>
    </button>
  </div>

  <nav class="mt-12 px-6">
    <ul class="flex flex-col items-center gap-8 text-center">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-exo text-3xl font-medium tracking-tight text-white transition hover:text-blue-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-auto flex flex-col gap-6 px-6 pb-12 pt-8">
    <a
      href="/authentification"
      class="flex items-center gap-4 text-white transition hover:text-blue-200"
      aria-label="Connexion"
    >
      <img src="/Profile.svg" alt="Connexion" class="h-8 w-8" />
      <span class="font-exo text-xl font-normal">Connexion</span>
    </a>
  </div>
</div>

<script>
  // Le script de fermeture est maintenant géré dans Header.astro
</script>
